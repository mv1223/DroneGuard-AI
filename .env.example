# DroneGuard AI Configuration
# Offline simulation and OpenCV heuristic modes work without any API keys.

# Vision mode: simulation | auto | openai | gemini | ollama | opencv_heuristic
VLM_MODE=simulation
VLM_PROVIDER=auto
VLM_TIMEOUT_SECONDS=30
VLM_MAX_RETRIES=2

# LLM Analyst mode: offline | auto | openai | gemini | ollama
LLM_PROVIDER=offline

# OpenAI Credentials (optional, required only for openai VLM/LLM modes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Credentials (optional, required only for gemini VLM/LLM modes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama Server (optional, for local open-weight VLMs/LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VLM_MODEL=llava
OLLAMA_LLM_MODEL=llama3.2

# Security & Safety Rules
NIGHT_START_HOUR=0
NIGHT_END_HOUR=5
LOW_BATTERY_THRESHOLD=20
CRITICAL_BATTERY_THRESHOLD=15
MAX_ALTITUDE_METERS=60
LOITERING_SECONDS=120
LOITERING_MIN_OBSERVATIONS=2
DUPLICATE_ALERT_WINDOW_SECONDS=300
RESTRICTED_ZONES=Restricted Zone,Restricted Area,Server Perimeter,Loading Dock B

# Video Frame Extraction Defaults
DEFAULT_FRAME_INTERVAL_SECONDS=2.0
MAX_VIDEO_FRAMES=60
